select 
	c.endereco_wallet,
	c.rede_blockchain,
	c.saldo_usd,
	i.nome as investidor,
	i.cpf
from carteiras c
join investidores i on c.investidor_id = i.id
where c.status in ('Ativa', 'Em Analise');

select
	co.nome_exchange,
	sum(t.valor_pago) as total_movimentado
from transacoes_cripto t
join criptomoedas cr on t.criptomoeda_id = cr.id
join corretoras co on cr.corretora_id = co.id
group by co.nome_exchange;

select 
	c.endereco_wallet,
	cr.nome_moeda,
	t.quantidade,
	t.valor_pago,
	t.data_transacao
from transacoes_cripto t
join carteiras c on t.carteira_id = c.id
join criptomoedas cr on t.criptomoeda_id = cr.id
where t.valor_pago > 500.00
order by t.valor_pago desc;

create view vw_painel_carteiras as
select 
	c.endereco_wallet,
	c.rede_blockchain,
	c.status,
	c.saldo_usd,
	i.nome as investidor,
	i.cpf
from carteiras c
join investidores i on c.investidor_id = i.id;

create view vw_investimento_total_carteiras as
select 
    c.id as carteira_id,
    c.endereco_wallet,
    c.saldo_usd,
    count(t.id) as total_transacoes,
    coalesce(sum(t.valor_pago), 0) as custo_total
from carteiras c
left join transacoes_cripto t on c.id = t.carteira_id
group by c.id, c.endereco_wallet, c.saldo_usd;
